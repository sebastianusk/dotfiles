{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-openagent",
    "opencode-mem",
    "@nick-vi/opencode-type-inject",
    "opencode-vibeguard",
    "@rama_nigg/open-cursor@latest"
  ],
  "provider": {
    "cursor-acp": {
      "name": "Cursor ACP",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:32124/v1"
      },
      "models": {
        "cursor-acp/auto": { "name": "Auto" },
        "cursor-acp/composer-1.5": { "name": "Composer 1.5" },
        "cursor-acp/composer-1": { "name": "Composer 1" }
      }
    }
  },
  "permission": {
    "bash": "ask",
    "write": "ask",
    "edit": "ask",
    "task": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow"
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "enabled": true
    },
    "glean": {
      "type": "remote",
      "url": "https://jago-be.glean.com/mcp/default"
    }
  }
}
