{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@0.2.8",
    "./extensions/hermes-memory/plugin.ts",
    "./extensions/approval-review/plugin.ts",
    "opencode-vibeguard@0.1.0",
    "context-mode@1.0.169"
  ],
  // "model": "openai/gpt-5.6-sol",
  "model": "opencode-go/glm-5.3-flash",
  // "small_model": "openai/gpt-5.6-luna",
  "small_model": "opencode-go/gpt-5.6-luna",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [
      "~/dotfiles/config/opencode/skills",
      "~/Documents/brain/agent/skills"
    ]
  },
  "references": {
    "brain": {
      "path": "~/Documents/brain",
      "description": "Obsidian brain vault for task notes, project context, and linked external resources"
    }
  },
  "agent": {},
  "permission": {
    "bash": {
      "*": "ask",
      "node ~/Documents/brain/scripts/vault-tools.js *": "allow",
      "node /Users/seb/Documents/brain/scripts/vault-tools.js *": "allow",
      "node \"~/Documents/brain/scripts/vault-tools.js\" *": "allow",
      "node \"/Users/seb/Documents/brain/scripts/vault-tools.js\" *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "nl *": "allow",
      "jq *": "allow",
      "file *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "uname *": "allow",
      "date": "allow",
      "printenv PATH": "allow",
      "printenv PWD": "allow",
      "printenv SHELL": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "tree *": "allow",
      "bat *": "allow",
      "rg *": "allow",
      "eza *": "allow",
      "exa *": "allow",
      "shasum *": "allow",
      "bash -n *": "allow",
      "opencode debug *": "allow",
      "test *": "allow",
      "printf *": "allow",
      "true": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git branch --list *": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git tag --list *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git grep *": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git describe *": "allow",
      "git blame *": "allow",
      "bun test *": "allow",
      "npm test *": "allow",
      "pnpm test *": "allow",
      "make test *": "allow",
      "bun install --frozen-lockfile *": "allow",
      "npm ci *": "allow",
      "pnpm install --frozen-lockfile *": "allow",
      "sort -o *": "deny",
      "rg --pre *": "deny",
      "tee *": "ask",
      "dd *": "ask",
      "* > *": "ask",
      "* >> *": "ask"
    },
    "write": "ask",
    "edit": "ask",
    "task": "ask",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "external_directory": {
      "*": "ask",
      "~/Documents/brain/**": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "enabled": true
    }
  }
}
