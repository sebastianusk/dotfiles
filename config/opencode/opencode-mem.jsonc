{
  // User identity
  "userNameOverride": "Sebastian",
  "userEmailOverride": "sebastianus.kurniawan@gmail.com",

  // Storage
  "storagePath": "~/.opencode-mem/data",

  // Auto-capture (enabled)
  "autoCaptureEnabled": true,
  "autoCaptureLanguage": "auto",

  // AI provider (using opencode built-in — no separate API key needed)
  "opencodeProvider": "anthropic",
  "opencodeModel": "claude-haiku-4-5-20251001",

  // Web UI
  "webServerEnabled": true,
  "webServerPort": 4747,

  // Memory settings
  "maxMemories": 10,
  "userProfileAnalysisInterval": 10,

  // Compaction
  "compaction": {
    "enabled": true,
    "memoryLimit": 10
  },

  // Chat injection
  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "excludeCurrentSession": true,
    "injectOn": "first"
  },

  // Toasts
  "showAutoCaptureToasts": true,
  "showUserProfileToasts": true,
  "showErrorToasts": true
}
