#!/usr/bin/env bash

# AeroSpace + SketchyBar Configuration
# Dynamically creates workspace items based on aerospace workspace-to-monitor assignment
# Each monitor shows only its assigned workspaces

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Helper Functions #####
to_chinese() {
  case "$1" in
    0) echo "零" ;;
    1) echo "一" ;;
    2) echo "二" ;;
    3) echo "三" ;;
    4) echo "四" ;;
    5) echo "五" ;;
    6) echo "六" ;;
    7) echo "七" ;;
    8) echo "八" ;;
    9) echo "九" ;;
  esac
}

##### Bar Appearance #####
sketchybar --bar position=top height=40 blur_radius=30 color=0x40000000

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Bold:17.0"
  label.font="JetBrainsMono Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Add Event #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event media_change

##### Create workspace items for each monitor #####
# Map aerospace monitor-id to sketchybar display using NSScreen IDs
# aerospace format: "%{monitor-id} %{monitor-appkit-nsscreen-screens-id}"
aerospace list-monitors --format "%{monitor-id} %{monitor-appkit-nsscreen-screens-id}" | while read -r aero_monitor sb_display; do
  # Get workspaces for this monitor
  for ws in $(aerospace list-workspaces --monitor "$aero_monitor" 2>/dev/null | sort -n); do
    sketchybar --add item space.$ws left \
        --subscribe space.$ws aerospace_workspace_change \
        --set space.$ws \
        display=$sb_display \
        padding_left=3 \
        padding_right=3 \
        background.color=0x15ffffff \
        background.border_color=0x66ffffff \
        background.border_width=1 \
        background.corner_radius=4 \
        background.height=22 \
        background.drawing=on \
        icon.drawing=on \
        icon="" \
        icon.padding_left=6 \
        icon.padding_right=4 \
        label="$(to_chinese $ws)" \
        click_script="aerospace workspace $ws" \
        script="$PLUGIN_DIR/aerospace.sh $ws"
  done
done

##### Adding Center Items #####
sketchybar --add item front_app q \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched \
           --add item media e \
           --set media update_freq=2 icon= label.color=0xffffffff label.max_chars=35 label.scroll_duration=300 scroll_texts=on icon.padding_left=0 background.drawing=off script="$PLUGIN_DIR/media.sh" click_script="open -a 'Kaset'"

##### Adding Right Items #####
sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item cpu right \
           --set cpu update_freq=5 icon=C icon.color=0xffffffff script="$PLUGIN_DIR/cpu.sh" \
           --add item memory right \
           --set memory update_freq=5 icon=M icon.color=0xffffffff script="$PLUGIN_DIR/memory.sh" \
           --add item bluetooth right \
           --set bluetooth icon= click_script="open raycast://extensions/VladCuciureanu/toothpick/manage-bluetooth-connections"

##### Force all scripts to run the first time #####
sketchybar --update
